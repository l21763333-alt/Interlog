{
  "description": "Iterlog lifecycle hooks for Claude Code",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/run_iterlog.js",
              "--host",
              "claude",
              "session-context-hook"
            ],
            "timeout": 10,
            "statusMessage": "Iterlog: loading the portable runtime bridge"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/run_iterlog.js",
              "--host",
              "claude",
              "capture-hook"
            ],
            "timeout": 60,
            "statusMessage": "Iterlog: preserving context before automatic compaction"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/run_iterlog.js",
              "--host",
              "claude",
              "postcompact-hook"
            ],
            "timeout": 10,
            "statusMessage": "Iterlog: recording automatic compaction completion"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^iterlog:iterlog$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/run_iterlog.js",
              "--host",
              "claude",
              "subagent-context-hook"
            ],
            "timeout": 10,
            "statusMessage": "Iterlog: loading evidence for the reporting subagent"
          }
        ]
      }
    ]
  }
}
